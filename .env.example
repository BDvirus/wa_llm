WHATSAPP_HOST=http://localhost:3000
WHATSAPP_BASIC_AUTH_USER=admin
WHATSAPP_BASIC_AUTH_PASSWORD=admin
VOYAGE_API_KEY=your_voyage_api_key
DB_URI=postgresql+asyncpg://user:password@localhost:5432/postgres
LOG_LEVEL=INFO
# Set the API key matching MODEL_NAME's provider. MODEL_NAME defaults to
# anthropic:claude-sonnet-4-6, so ANTHROPIC_API_KEY is required unless you change it.
ANTHROPIC_API_KEY=your-key-here

# To go through OpenRouter instead, set these two and drop ANTHROPIC_API_KEY:
# OPENROUTER_API_KEY=sk-or-v1-...
# MODEL_NAME=openrouter:anthropic/claude-sonnet-4.6

LOGFIRE_TOKEN=your-key-here

# Do NOT wrap these lists in quotes, as that may cause JSON parsing errors in some environments (Docker/Linux).
QA_TESTERS=["2501234567@s.whatsapp.net", "1543210987@s.whatsapp.net"]
QA_TEST_GROUPS=["132456@g.us"]

# Private chat with the bot: requests one user may make in a rolling 24h window.
DM_DAILY_QUOTA=20

# --- Production: Traefik + Authentik (docker-compose.prod.yml) ---------------
# Read by docker compose for interpolation (e.g. Komodo's stack Environment),
# not by the app. Dev compose files ignore them.
#
# Hostnames Traefik routes to the admin page/API and to gowa's UI (required).
WA_LLM_HOST=wa-llm.home.lan
GOWA_HOST=gowa.home.lan
# Traefik's external docker network, and its TLS entrypoint.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
# Traefik middleware doing Authentik forward-auth: <name>@docker when defined
# with labels (e.g. on the authentik outpost), <name>@file in a file provider.
AUTHENTIK_MIDDLEWARE=authentik@docker
# Proxies uvicorn trusts for X-Forwarded-*. Narrow it to Traefik's IP or subnet
# (e.g. 172.18.0.0/16); * trusts any container on the network.
FORWARDED_ALLOW_IPS=*
